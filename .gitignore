# Python
__pycache__/
*.pyc
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/

# Quarto
/.quarto/
/_book/
/_freeze/
site_libs/
**/*.quarto_ipynb

# Quarto scratch output from rendering a single file rather than the book
book/*.html
book/*_files/
/index.html
/index_files/

# Generated media (the book draws these live; keep only the seven in images/)
*.mp4
# ---- Local working material ----
# Scratch space, drafts, and reference material kept alongside the project but
# deliberately outside version control. Contents vary by repo and are not
# reproducible from history -- they're covered by file-level backup instead.
excluded/
requirements-frozen.txt
