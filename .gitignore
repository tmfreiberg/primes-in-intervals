# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env

# ---- Quarto ----
# Rendered output and caches. _freeze/ is ignored here; a project that
# commits it on purpose (so CI can render without executing) drops that
# line. An ignored _freeze/ is regenerable only by executing the notebooks.
_book/
_site/
.quarto/
_freeze/
site_libs/
# Quarto's intermediate notebooks, chapter.quarto_ipynb_1 included. Quarto
# appends its own "**/*.quarto_ipynb" line on render; leave it at the end.
*.quarto_ipynb*
# Output of rendering a single file rather than the whole book.
book/*.html
book/*_files/
/index.html
/index_files/

# ---- Generated media ----
# Animations are written as GIFs into images/; video output is never kept.
*.mp4

# ---- Local working material ----
# Working material kept beside the project, excluded from version control
# by this file (not by .git/info/exclude).
excluded/

# ---- Update zips ----
# Temporary archives, extracted in place and then deleted.
/*-update-*.zip

# ---- Local notes ----
# A separate local repository, not part of this project.
/primes-in-intervals-private/
# Backstop: if a note lands here by mistake, git will not take it.
/handoff.txt
/backlog.txt
/backup.txt
/devnotes.txt

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

**/*.quarto_ipynb
